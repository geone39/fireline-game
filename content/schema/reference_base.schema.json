{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/reference_bases/*.yaml",
  "description": "Reference base: a layout in the svc/base format (items {uid,type,level,x,y,rot}) plus map and HQ level. Used by golden replays and simbattle.",
  "type": "object",
  "required": ["schema", "id", "name_key", "reference", "hq_level", "map", "layout"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^ref_hq[0-9]{2}(_[a-z][a-z0-9_]*)?$"},
    "name_key": {"type": "string", "minLength": 1},
    "reference": {"const": true},
    "hq_level": {"type": "integer", "minimum": 1, "maximum": 10},
    "map": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "layout": {
      "type": "object", "required": ["items"], "additionalProperties": false,
      "properties": {"items": {"type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["uid", "type", "level", "x", "y", "rot"], "additionalProperties": false,
        "properties": {
          "uid": {"type": "string", "minLength": 1},
          "type": {"type": "string", "pattern": "^[bd]_[a-z0-9_]+$"},
          "level": {"type": "integer", "minimum": 1},
          "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
          "rot": {"type": "integer", "minimum": 0, "maximum": 3}}}}}
    }
  }
}
